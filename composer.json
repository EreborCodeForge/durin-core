{
  "name": "ereborcodeforge/durin-core",
  "description": "Project model and deterministic tooling primitives for Durin.",
  "type": "library",
  "license": "MIT",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Thales Ruppenthal",
      "email": "thales.rup@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "EreborCodeForge\\Durin\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EreborCodeForge\\Durin\\Core\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
